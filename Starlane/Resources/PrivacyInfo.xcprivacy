<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Starlane serves ads through Google AdMob, which uses the advertising identifier to
	     personalise them where the player has allowed it. That is tracking as Apple defines it. -->
	<key>NSPrivacyTracking</key>
	<true/>
	<!-- Deliberately empty. Google does not publish a tracking-domain list for the Mobile Ads SDK,
	     and any domain listed here is hard-blocked by iOS whenever ATT is denied — which would break
	     the non-personalised ads the SDK is supposed to fall back to. The SDK gates its own use of
	     the IDFA on the ATT decision. Revisit if Google ever publishes a list. -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- The app itself still collects nothing: the player profile is a local JSON file and purchases
	     are handled by StoreKit. What the ad SDK collects is declared in its own privacy manifest,
	     inside GoogleMobileAds.xcframework, and Xcode merges the two into the privacy report. The
	     App Store Connect answers must cover both — see ADMOB.md. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- StoreKitPurchaseService stores this install's appAccountToken so purchases can be
			     matched to the player. Read and written only by this app. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
